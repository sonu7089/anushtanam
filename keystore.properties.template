# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# real Play upload-key details. When present, release builds are signed with this
# key; when absent, they fall back to the debug key (installable, but NOT publishable).
#
# Create an upload keystore once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
#
# Then build the Play artifact with:  ./gradlew bundleRelease   (produces app-release.aab)

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
