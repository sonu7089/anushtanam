    <!-- ===================================================================
         Purashcharana — the great sankalpa: one lakh japa per akshara.
         Counts are written with Indian digit grouping (1,00,000 / 24,00,000)
         because that is how the reader thinks about lakhs.
         =================================================================== -->
    <string name="title_purashcharana">Purashcharana</string>
    <string name="home_purashcharana_title">Purashcharana — the great sankalpa</string>
    <string name="home_purashcharana_subtitle_open">One lakh japa for every akshara of the Gayatri. Read what it asks before you begin.</string>
    <string name="home_purashcharana_subtitle_enrolled">%1$s of %2$s japa</string>
    <string name="home_purashcharana_cta">Open Purashcharana</string>

    <string name="purashcharana_what_title">What a Purashcharana is</string>
    <string name="purashcharana_what_body">A Purashcharana is the great mission of a mantra sadhak: to recite the mantra one lakh — 1,00,000 — times for every akshara, every syllable, that it holds. The Gayatri holds 24 aksharas, so a full Purashcharana is 24 x 1,00,000 = 24,00,000 japa. This is the work of years, not weeks, and it is meant to be. Anushtanam only keeps the count and marks each milestone as it passes, so you always know where you stand on the path.</string>
    <string name="purashcharana_math_format">%1$d aksharas x 1,00,000 = %2$s japa</string>
    <string name="purashcharana_gayatri_note">The 24 aksharas are the three padas of the Savitri Gayatri itself. The pranava and the vyahritis are not counted.</string>
    <string name="purashcharana_take_sankalpa">Take the Sankalpa</string>
    <string name="purashcharana_sankalpa_dialog_title">Take this sankalpa?</string>
    <string name="purashcharana_sankalpa_dialog_body">You are vowing to recite 24,00,000 Gayatri japa, for as many years as it takes. Only japa that Anushtanam hears and verifies will count towards it. You may set the sankalpa aside at any time, and the japa you have counted stays in your record.</string>
    <string name="purashcharana_sankalpa_dialog_confirm">Yes, I take it</string>
    <string name="purashcharana_sankalpa_dialog_cancel">Not yet</string>
    <string name="purashcharana_enrolled_snack">Sankalpa taken. May it be completed.</string>

    <string name="purashcharana_progress_format">%1$s of %2$s</string>
    <string name="purashcharana_percent_format">%1$s%% complete</string>
    <string name="purashcharana_day_number">Day %1$d of your sankalpa</string>
    <string name="purashcharana_remaining_format">%1$s japa remaining</string>
    <string name="purashcharana_next_milestone_format">Next milestone: %1$s</string>

    <string name="purashcharana_pace_title">Your pace</string>
    <string name="purashcharana_pace_none">No verified japa yet, so there is nothing to measure. Recite a few and your pace will appear here.</string>
    <string name="purashcharana_pace_format">About %1$d japa a day so far</string>
    <string name="purashcharana_eta_format">At this pace, about %1$s to go</string>
    <string name="purashcharana_eta_years">%1$d years</string>
    <string name="purashcharana_eta_months">%1$d months</string>
    <string name="purashcharana_eta_days">%1$d days</string>

    <string name="purashcharana_milestones_title">Milestones on the path</string>
    <string name="purashcharana_milestone_reached">Reached</string>
    <string name="purashcharana_milestone_next">Next</string>

    <string name="purashcharana_niyama_title">Niyama — keeping the sankalpa</string>
    <string name="purashcharana_niyama_body">Sit at the same time each day, on the same seat, facing the same direction. Come with a clean body and an unhurried mind. Do not skip a day meaning to make it up with a bigger count tomorrow — it is the small daily number that finishes a Purashcharana. And do not announce your count to others; the vow is between you and the mantra.</string>

    <string name="purashcharana_counting_title">How the count is kept</string>
    <string name="purashcharana_counting_body">Only japa that Anushtanam actually hears and verifies is counted. Nothing can be added by hand — there is no way to type a number in, and no one can raise it for you. What you see here is an honest record of what you truly recited. While you are signed in, that record is also kept safe against your account, so a new phone or a fresh install does not cost you the years already behind you.</string>

    <string name="purashcharana_withdraw">Set aside this sankalpa</string>
    <string name="purashcharana_withdraw_dialog_title">Set the sankalpa aside?</string>
    <string name="purashcharana_withdraw_dialog_body">The japa you have counted stays in your record; nothing is lost. You can take the sankalpa again whenever you are ready to continue.</string>
    <string name="purashcharana_withdraw_confirm">Set aside</string>
    <string name="purashcharana_withdraw_cancel">Keep going</string>
    <string name="purashcharana_withdrawn_snack">Sankalpa set aside.</string>

    <string name="purashcharana_complete_title">Purnahuti</string>
    <string name="purashcharana_complete_body">24,00,000 japa, every one of them heard and counted. Your Purashcharana is complete. Sit quietly with it for a while before you decide what comes next.</string>
