<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MantraSiddhi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MantraSiddhi.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Solid saffron window so the launch screen never flashes a dark/grey background. -->
        <item name="android:windowBackground">#FFC43E00</item>
        <item name="android:statusBarColor">#FFC43E00</item> <!-- Deep Saffron -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
