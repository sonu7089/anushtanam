# Baseline v1: startup, frames, scheduling and memory. SDK composition tracing is
# not enabled by this harness. Exclude global track_event: unrelated Chromium
# producers on the reference device cause 30-second start/stop timeouts.
buffers { size_kb: 32768 fill_policy: RING_BUFFER }
buffers { size_kb: 4096 fill_policy: RING_BUFFER }
write_into_file: true
file_write_period_ms: 2500
data_source_stop_timeout_ms: 2500
data_sources { config {
  name: "linux.ftrace"
  target_buffer: 0
  ftrace_config {
    ftrace_events: "task/task_newtask"
    ftrace_events: "task/task_rename"
    ftrace_events: "sched/sched_process_exit"
    ftrace_events: "sched/sched_process_free"
    ftrace_events: "kmem/rss_stat"
    ftrace_events: "oom/oom_score_adj_update"
    atrace_categories: "am"
    atrace_categories: "wm"
    atrace_categories: "view"
    atrace_categories: "gfx"
    atrace_categories: "sched"
    atrace_categories: "freq"
    atrace_categories: "idle"
    atrace_categories: "binder_driver"
    atrace_categories: "dalvik"
    atrace_apps: "shastralife.anushtanam"
    atrace_apps: "com.mantrasiddhi.macrobenchmark"
    compact_sched { enabled: true }
  }
} }
data_sources { config {
  name: "linux.process_stats"
  target_buffer: 1
  process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 10000 }
} }
data_sources { config { name: "android.packages_list" target_buffer: 1 } }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
