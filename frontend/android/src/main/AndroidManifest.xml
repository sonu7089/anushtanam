<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Firebase (Auth + Firestore + Cloud Messaging) network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sandhya Vandan reminders. We deliberately use inexact alarms, so we declare
         neither USE_EXACT_ALARM nor SCHEDULE_EXACT_ALARM (both draw Google Play
         exact-alarm review that a devotional reminder cannot justify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional "Use my location" path; the manual region picker works without it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- enableOnBackInvokedCallback=false: targetSdk 36 (Android 16) turns predictive
         back ON by default; opting out preserves the exact pre-36 back-navigation
         behavior. Deliberate no-behavior-change choice for the compliance update. -->
    <application
        android:fullBackupContent="@xml/message_backup_rules"
        android:dataExtractionRules="@xml/message_data_extraction_rules"
        android:name=".MantraSiddhiApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MantraSiddhi">
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <service android:name=".data.sync.CloudSyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service android:name="com.mantrasiddhi.data.messages.TeachingDeliveryJob"
            android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <activity
            android:name=".presentation.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MantraSiddhi" />
        <!-- Retain the installed launcher component/shortcuts; Android supplies the splash. -->
        <activity-alias
            android:name=".presentation.SplashActivity"
            android:targetActivity=".presentation.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Fires preparation and event reminders; logs, notifies, re-arms. -->
        <receiver
            android:name=".data.sandhya.SandhyaAlarmReceiver"
            android:exported="false" />

        <!-- Handles the "Mark as done" notification action. -->
        <receiver
            android:name=".data.sandhya.SandhyaActionReceiver"
            android:exported="false" />

        <!-- Re-arms reminders after reboot or a clock/timezone change. -->
        <receiver
            android:name=".data.sandhya.SandhyaBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Receives FCM pushes (delivered by the optional Blaze Cloud Function) and
             new-token events; posts a local notification via GoalNotifier. -->
        <service
            android:name=".data.remote.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
