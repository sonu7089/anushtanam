rules_version = '2';

// Anushtanam (shastralife.anushtanam) — Firestore security rules for the Phase B
// cloud backend. MF-08 adds private session performance and practice history,
// with an incremental restore feed. Linked families still read compact summaries.
//
// Identity model:
//   - Adult: Google or real email and password, one profile per account.
//   - Child: own Google account, with a synthetic email for ID and PIN sign-in.
//     The 12-digit ID and PIN can also verify a direct family link.
//
// Account data requires authentication. MF-10 adds a public projection containing
// only generic teachings; publishing and campaign records remain private.

service cloud.firestore {
  match /databases/{database}/documents {
    // Generic teachings are public. Drafts, audiences and send history stay private.
    match /publishedContent/{contentId} {
      allow read: if true;
      allow write: if false;
    }
    match /messageInstallations/{installationId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        (!exists(/databases/$(database)/documents/messageInstallations/$(installationId)) || resource.data.uid == request.auth.uid) &&
        request.resource.data.keys().hasOnly(['uid', 'token', 'enabled', 'schemaVersion', 'locale', 'appVersion', 'updatedAt', 'notificationOnly']) &&
        (!('notificationOnly' in request.resource.data) || request.resource.data.notificationOnly is bool) &&
        request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096 &&
        request.resource.data.enabled is bool && request.resource.data.schemaVersion == 1 &&
        request.resource.data.locale == 'en' && request.resource.data.appVersion is int &&
        request.resource.data.updatedAt == request.time;
    }
    // No client grants for contentDrafts, campaigns, messagePublicationJobs,
    // messageTestDevices, messageControls or messageAudit. Admin SDK only.

    // --- helpers ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(uid, role) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == role;
    }

    function validParticipants(data, linkId) {
      return data.keys().hasAll(['parentUid', 'childUid', 'parentName', 'childName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['parentUid', 'childUid', 'parentName', 'childName', 'status', 'createdAt', 'updatedAt', 'method', 'inviteToken']) &&
        data.parentUid != data.childUid && linkId == data.parentUid + '_' + data.childUid &&
        hasRole(data.parentUid, 'PARENT') && hasRole(data.childUid, 'CHILD') &&
        data.parentName == get(/databases/$(database)/documents/users/$(data.parentUid)).data.displayName &&
        (data.status != 'APPROVED' || data.childName == get(/databases/$(database)/documents/users/$(data.childUid)).data.displayName) &&
        data.updatedAt == request.time;
    }

    function validQrLink(data) {
      let token = data.inviteToken;
      let invite = get(/databases/$(database)/documents/familyInvites/$(token)).data;
      let redeemed = getAfter(/databases/$(database)/documents/familyInvites/$(token)).data;
      return data.method == 'QR' && data.parentUid == request.auth.uid &&
        token.matches('[a-f0-9]{64}') && invite.childUid == data.childUid &&
        invite.usedBy == '' && request.time < invite.createdAt + duration.value(5, 'm') &&
        get(/databases/$(database)/documents/familyInviteState/$(data.childUid)).data.token == token &&
        redeemed.usedBy == request.auth.uid && redeemed.usedAt == request.time;
    }

    function childPinLink(data) {
      return data.childUid == request.auth.uid && data.method == 'PIN' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    // True if an APPROVED link exists between the given parent and child uids.
    function isApprovedLink(parentUid, childUid) {
      let id = parentUid + '_' + childUid;
      return exists(/databases/$(database)/documents/links/$(id)) &&
        get(/databases/$(database)/documents/links/$(id)).data.status == 'APPROVED';
    }

    // --- users/{uid} -----------------------------------------------------------
    // A user may always read their own doc. Another user's doc is readable only when
    // an APPROVED link exists between them (either direction) — this lets a parent
    // read a linked child's displayName / fcmToken, and vice versa. Code lookups go
    // through the dedicated childCodes collection, so users reads stay self-or-linked.
    // A user may only write their own doc.
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isApprovedLink(request.auth.uid, uid) ||
        isApprovedLink(uid, request.auth.uid)
      );
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role in ['PARENT', 'CHILD', 'INDIVIDUAL'];
      // A Google identity belongs to one profile. Its family role cannot be changed.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        (!('linkCode' in resource.data) || request.resource.data.linkCode == resource.data.linkCode);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // --- childCodes/{code} -----------------------------------------------------
    // Maps a 12-digit code -> child uid. Any signed-in user may read (a parent must
    // resolve a code to send a link request). A child may create only their own code
    // doc (uid must equal their auth uid). Codes are immutable: no update/delete.
    match /childCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && code.matches('[0-9]{12}') &&
        request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid &&
        (request.auth.token.email == 'c' + code + '@child.anushtanam.app' ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CHILD' &&
           getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkCode == code));
      allow update, delete: if false;
    }

    // --- links/{parentUid}_{childUid} -----------------------------------------
    // Direct approval requires the child's password session or atomic QR redemption.
    // Old pending requests remain readable and can still be answered by the child.
    match /links/{linkId} {
      allow get: if isSignedIn() && (
        linkId.matches(request.auth.uid + '_.*') || linkId.matches('.*_' + request.auth.uid)
      );
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.parentUid ||
        request.auth.uid == resource.data.childUid
      );
      allow create: if isSignedIn() && validParticipants(request.resource.data, linkId) &&
        request.resource.data.createdAt == request.time && (
          (request.resource.data.parentUid == request.auth.uid && request.resource.data.status == 'PENDING') ||
          (request.resource.data.status == 'APPROVED' &&
            (childPinLink(request.resource.data) || validQrLink(request.resource.data)))
        );
      allow update: if isSignedIn() && validParticipants(request.resource.data, linkId) &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.childUid == resource.data.childUid &&
        request.resource.data.createdAt == resource.data.createdAt && (
          (request.auth.uid == resource.data.childUid && request.resource.data.status in ['APPROVED', 'REJECTED']) ||
          (request.resource.data.status == 'APPROVED' && validQrLink(request.resource.data))
        );
      allow delete: if false;
    }

    // The invitation ID is a random 256-bit secret. It is never a child ID or PIN.
    // Parents may fetch a known invitation but cannot list invitations or read the
    // child's current token. Rules inspect that private state during redemption.
    match /familyInviteState/{childUid} {
      allow read: if isSignedIn() && request.auth.uid == childUid;
      allow create, update: if isSignedIn() && request.auth.uid == childUid && hasRole(childUid, 'CHILD') &&
        request.resource.data.keys().hasOnly(['token']) && request.resource.data.token.matches('[a-f0-9]{64}') &&
        getAfter(/databases/$(database)/documents/familyInvites/$(request.resource.data.token)).data.childUid == childUid &&
        getAfter(/databases/$(database)/documents/familyInvites/$(request.resource.data.token)).data.createdAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == childUid;
    }

    match /familyInvites/{token} {
      allow get: if isSignedIn() && (resource.data.childUid == request.auth.uid || hasRole(request.auth.uid, 'PARENT'));
      allow list: if false;
      allow create: if isSignedIn() && token.matches('[a-f0-9]{64}') &&
        request.resource.data.keys().hasOnly(['childUid', 'childName', 'createdAt', 'usedBy']) &&
        request.resource.data.childUid == request.auth.uid && hasRole(request.auth.uid, 'CHILD') &&
        request.resource.data.childName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
        request.resource.data.createdAt == request.time && request.resource.data.usedBy == '' &&
        getAfter(/databases/$(database)/documents/familyInviteState/$(request.auth.uid)).data.token == token;
      allow update: if isSignedIn() && hasRole(request.auth.uid, 'PARENT') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']) &&
        resource.data.usedBy == '' && request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.usedAt == request.time &&
        request.time < resource.data.createdAt + duration.value(5, 'm') &&
        get(/databases/$(database)/documents/familyInviteState/$(resource.data.childUid)).data.token == token &&
        getAfter(/databases/$(database)/documents/links/$(request.auth.uid + '_' + resource.data.childUid)).data.status == 'APPROVED' &&
        getAfter(/databases/$(database)/documents/links/$(request.auth.uid + '_' + resource.data.childUid)).data.inviteToken == token;
      // Account deletion uses the Admin SDK. A client cannot delete and recreate a
      // consumed invitation to make the same secret usable again.
      allow delete: if false;
    }

    // v1 is the shipped unversioned backup schema; explicit v1 is also understood.
    function v1(d) { return !('schemaVersion' in d) || (d.schemaVersion is int && d.schemaVersion == 1); }
    function identity(v) { return v is string && v.size() > 0 && v.size() <= 1400 && v.matches('[^/]+') && !(v in ['.', '..']); }
    function nullableId(v) { return v == null || identity(v); }
    function count(v) { return v is int && v >= 0; }
    function millis(v) { return count(v) && v <= 253402300799999; }
    function nullableMillis(v) { return v == null || millis(v); }
    function dateKey(v) { return v is string && v.matches('[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])') && !v.matches('0000.*'); }
    function zone(v) { return v is string && v.size() > 0 && v.size() <= 200; }
    function period(v) { return v in ['PRATAH', 'MADHYAHNA', 'SAYAM']; }
    function revision(v) { return v is int && v > 0 && v < 9223372036854775807; }
    function score(v) { return v is number && v >= 0 && v <= 1; }

    function validEntry(d) {
      return v1(d) && d.keys().hasAll(['id', 'mantraId', 'dateKey', 'zoneId', 'period', 'quantity', 'revision',
          'createdAtMillis', 'targetId', 'vowId', 'source', 'updatedAtMillis', 'operationId']) &&
        d.keys().hasOnly(['id', 'mantraId', 'dateKey', 'zoneId', 'period', 'quantity', 'revision',
          'createdAtMillis', 'targetId', 'vowId', 'source', 'updatedAtMillis', 'operationId', 'sessionStableId', 'schemaVersion']) &&
        identity(d.id) && identity(d.mantraId) && identity(d.operationId) && dateKey(d.dateKey) && zone(d.zoneId) &&
        count(d.quantity) && revision(d.revision) && millis(d.createdAtMillis) && millis(d.updatedAtMillis) &&
        d.updatedAtMillis >= d.createdAtMillis && nullableId(d.targetId) && nullableId(d.vowId) &&
        (!('sessionStableId' in d) || nullableId(d.sessionStableId)) &&
        ((d.source == 'SANDHYA' && period(d.period) && (!('sessionStableId' in d) || d.sessionStableId == null)) ||
         (d.source == 'AUDIO_ACCEPTED' && d.period == null && d.quantity == 1));
    }
    function validJapaGoal(d) {
      return v1(d) && identity(d.id) && identity(d.mantraId) && millis(d.startedAtMillis) &&
        nullableMillis(d.endedAtMillis) && count(d.baselineCount) && count(d.targetCount) && d.targetCount > 0 && (
          (d.kind == 'target' && d.keys().hasOnly(['id', 'kind', 'mantraId', 'startedAtMillis', 'endedAtMillis',
            'baselineCount', 'targetCount', 'rewardType', 'rewardDescription', 'schemaVersion']) &&
            d.targetCount <= 2147483647 && d.rewardType is string && d.rewardType.size() <= 100 &&
            d.rewardDescription is string && d.rewardDescription.size() <= 200000) ||
          (d.kind == 'vow' && d.keys().hasOnly(['id', 'kind', 'mantraId', 'startedAtMillis', 'endedAtMillis',
            'baselineCount', 'targetCount', 'aksharas', 'completedAtMillis', 'schemaVersion']) &&
            d.aksharas is int && d.aksharas > 0 && d.aksharas <= 2147483647 && nullableMillis(d.completedAtMillis)));
    }
    function published(uid, type, id, value) {
      let feed = getAfter(/databases/$(database)/documents/users/$(uid)/backupChanges/$(type + '_' + id)).data;
      return feed.type == type && feed.id == id && feed.value == value && feed.changedAt == request.time;
    }
    function validAssignedGoal(d) {
      return d.keys().hasOnly(['parentUid', 'childUid', 'rewardType', 'rewardDescription', 'targetRecitationCount',
          'currentRecitationCount', 'isCompleted', 'createdAt']) &&
        identity(d.parentUid) && identity(d.childUid) && d.parentUid != d.childUid &&
        d.rewardType in ['MONEY', 'FOOD', 'GIFT', 'OUTING', 'TOY', 'OTHER'] &&
        d.rewardDescription is string && d.rewardDescription.size() <= 200000 && d.createdAt is timestamp &&
        d.targetRecitationCount is int && d.targetRecitationCount > 0 && d.targetRecitationCount <= 2147483647 &&
        count(d.currentRecitationCount) && d.currentRecitationCount <= d.targetRecitationCount &&
        d.isCompleted is bool && d.isCompleted == (d.currentRecitationCount == d.targetRecitationCount);
    }

    // --- goals/{autoId} --------------------------------------------------------
    // Create/edit reward+target: only the parent, and only when an APPROVED link to
    //   the childUid exists.
    // Read: either participant (parent or child).
    // Child update: the child may update ONLY currentRecitationCount / isCompleted on
    //   their own goals (all other fields must be unchanged); this is how recitation
    //   progress is recorded. Delete: never.
    match /goals/{goalId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.parentUid ||
        request.auth.uid == resource.data.childUid
      );

      allow create: if isSignedIn() &&
        validAssignedGoal(request.resource.data) && request.resource.data.createdAt == request.time &&
        request.resource.data.currentRecitationCount == 0 &&
        request.resource.data.parentUid == request.auth.uid &&
        isApprovedLink(request.auth.uid, request.resource.data.childUid);

      // Parent edit (reward / target changes), still requires the approved link.
      allow update: if isSignedIn() &&
        validAssignedGoal(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt &&
        request.auth.uid == resource.data.parentUid &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.childUid == resource.data.childUid &&
        isApprovedLink(request.auth.uid, resource.data.childUid);

      // Child progress update: only the two progress fields may change.
      allow update: if isSignedIn() &&
        validAssignedGoal(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRecitationCount', 'isCompleted']) &&
        request.auth.uid == resource.data.childUid &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.childUid == resource.data.childUid &&
        request.resource.data.rewardType == resource.data.rewardType &&
        request.resource.data.rewardDescription == resource.data.rewardDescription &&
        request.resource.data.targetRecitationCount == resource.data.targetRecitationCount;

      allow delete: if false;
    }

    // Preserve pre-repair projections without exposing private source history to parents.
    match /users/{uid}/projectionRepairs/{repairId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['version', 'kind', 'value', 'createdAt']) &&
        request.resource.data.version == 2 && request.resource.data.kind in ['progress', 'goal'] &&
        request.resource.data.value is map && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Editable japa is private to its owner and never writes parent-assigned rewards.
    match /users/{uid}/japaEntries/{entryId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.id == entryId && validEntry(request.resource.data) &&
        published(uid, 'entry', entryId, request.resource.data) &&
        (!exists(/databases/$(database)/documents/users/$(uid)/japaEntries/$(entryId)) ||
          (request.resource.data.revision >= resource.data.revision &&
           (!('targetId' in resource.data) || resource.data.targetId == null || request.resource.data.targetId == resource.data.targetId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'revision', 'updatedAtMillis', 'operationId', 'targetId', 'schemaVersion'])));
      allow delete: if false;
      match /revisions/{operationId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.operationId == operationId && request.resource.data.id == entryId && validEntry(request.resource.data);
        allow update: if isSignedIn() && request.auth.uid == uid && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /users/{uid}/japaGoals/{goalId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.id == goalId && validJapaGoal(request.resource.data) &&
        published(uid, 'goal', goalId, request.resource.data) &&
        (!exists(/databases/$(database)/documents/users/$(uid)/japaGoals/$(goalId)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAtMillis', 'completedAtMillis']));
      allow delete: if false;
    }

    // Full performance records are private to their owner, including children.
    match /users/{uid}/practiceRecords/{recordId} {
      function validRecord(d) {
        return v1(d) && identity(d.id) && recordId == d.type + '_' + d.id && (
          (d.type == 'session' && d.keys().hasOnly(['type', 'id', 'entryId', 'mantraId', 'mode',
            'overallScore', 'wordScoresJson', 'transcription', 'isCorrect', 'durationMs', 'createdAt',
            'correctness', 'completeness', 'pronunciation', 'schemaVersion',
            'projectionDate', 'projectionZoneId', 'childGoalEligible']) &&
            (!('projectionDate' in d) && !('projectionZoneId' in d) && !('childGoalEligible' in d) ||
              (d.projectionDate is string && d.projectionDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
               zone(d.projectionZoneId) && d.childGoalEligible is bool &&
               (!d.childGoalEligible || (d.mode == 'NORMAL' && d.isCorrect)))) &&
            nullableId(d.entryId) && d.mode in ['PRACTICE', 'NORMAL'] && identity(d.mantraId) && d.isCorrect is bool &&
            score(d.overallScore) && score(d.correctness) && score(d.completeness) &&
            score(d.pronunciation) && count(d.durationMs) && millis(d.createdAt) &&
            d.wordScoresJson is string && d.wordScoresJson.size() < 200000 &&
            d.transcription is string && d.transcription.size() < 200000) ||
          (d.type == 'sandhya' && d.keys().hasOnly(['type', 'id', 'dateKey', 'period',
            'scheduledEpochMillis', 'status', 'observedEpochMillis', 'schemaVersion']) &&
            dateKey(d.dateKey) && period(d.period) && d.id == d.dateKey + '_' + d.period &&
            d.status in ['NOTIFIED', 'MISSED', 'OBSERVED'] && millis(d.scheduledEpochMillis) &&
            nullableMillis(d.observedEpochMillis)) ||
          (d.type == 'change' && d.keys().hasOnly(['type', 'id', 'dateKey', 'period', 'zoneId', 'mode',
            'previousQuantity', 'quantity', 'revision', 'createdAtMillis', 'targetCompleted',
            'vowCompleted', 'completionReversed', 'milestonesCrossed', 'schemaVersion']) &&
            count(d.quantity) && (d.previousQuantity == null || count(d.previousQuantity)) && revision(d.revision) &&
            dateKey(d.dateKey) && period(d.period) &&
            zone(d.zoneId) && d.mode in ['RECORD', 'ADD', 'EDIT', 'COUNTER'] && millis(d.createdAtMillis) &&
            d.targetCompleted is bool && d.vowCompleted is bool && d.completionReversed is bool &&
            count(d.milestonesCrossed) && d.milestonesCrossed <= 2147483647)
        );
      }
      allow read: if isSignedIn() && request.auth.uid == uid;
      function sessionCounted() {
        let ref = /databases/$(database)/documents/progress/$(uid);
        let after = getAfter(ref).data;
        return !exists(ref) || !('sessionProjectionVersion' in get(ref).data) ||
          (after.sessionProjectionVersion == 2 &&
           after.sessionProjectionRevision == get(ref).data.sessionProjectionRevision + 1 &&
           after.totalSessions == get(ref).data.totalSessions + 1);
      }
      allow create: if isSignedIn() && request.auth.uid == uid && validRecord(request.resource.data) &&
        published(uid, 'practice', recordId, request.resource.data) &&
        (request.resource.data.type != 'session' || sessionCounted());
      allow update: if isSignedIn() && request.auth.uid == uid && validRecord(request.resource.data) && published(uid, 'practice', recordId, request.resource.data) && (
        request.resource.data == resource.data ||
        (resource.data.type == 'sandhya' && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'observedEpochMillis', 'scheduledEpochMillis']) &&
          (resource.data.status != 'OBSERVED' || request.resource.data.status == 'OBSERVED') &&
          (resource.data.status != 'MISSED' || request.resource.data.status != 'NOTIFIED')));
      allow delete: if false;
    }

    match /users/{uid}/japaConflicts/{conflictId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['id', 'entryId', 'first', 'second', 'resolved', 'schemaVersion']) && v1(request.resource.data) &&
        identity(conflictId) && validEntry(request.resource.data.first) && validEntry(request.resource.data.second) &&
        published(uid, 'conflict', conflictId, request.resource.data) &&
        request.resource.data.id == conflictId && request.resource.data.resolved == false &&
        request.resource.data.first.id == request.resource.data.entryId &&
        request.resource.data.second.id == request.resource.data.entryId &&
        request.resource.data.first == get(/databases/$(database)/documents/users/$(uid)/japaEntries/$(request.resource.data.entryId)).data &&
        request.resource.data.second == getAfter(/databases/$(database)/documents/users/$(uid)/japaEntries/$(request.resource.data.entryId)/revisions/$(request.resource.data.second.operationId)).data;
      allow update: if isSignedIn() && request.auth.uid == uid && request.resource.data.resolved == true &&
        published(uid, 'conflict', conflictId, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if false;
    }

    // Feed contents must match the canonical record in the same atomic write.
    match /users/{uid}/backupChanges/{changeId} {
      function canonical(d) {
        return (d.type == 'entry' && d.value == getAfter(/databases/$(database)/documents/users/$(uid)/japaEntries/$(d.id)).data) ||
          (d.type == 'goal' && d.value == getAfter(/databases/$(database)/documents/users/$(uid)/japaGoals/$(d.id)).data) ||
          (d.type == 'practice' && d.value == getAfter(/databases/$(database)/documents/users/$(uid)/practiceRecords/$(d.id)).data) ||
          (d.type == 'conflict' && d.value == getAfter(/databases/$(database)/documents/users/$(uid)/japaConflicts/$(d.id)).data);
      }
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['type', 'id', 'value', 'changedAt']) &&
        changeId == request.resource.data.type + '_' + request.resource.data.id &&
        request.resource.data.changedAt == request.time && canonical(request.resource.data);
      allow delete: if false;
    }

    // --- selfTargets/{uid} -----------------------------------------------------
    // One doc mirroring the user's ACTIVE self-set recitation target so it can be
    // restored after a reinstall / device switch. Strictly private: only the owner
    // may read or write (parent visibility goes through the goals system instead).
    match /selfTargets/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- purashcharana/{uid} ---------------------------------------------------
    // The sadhak's Purashcharana sankalpa (one lakh japa for every akshara) mirrored so a
    // count built over years survives reinstall / device switch. Strictly private: only the
    // owner may read or write. Parents see a child's effort through goals/ and progress/.
    match /purashcharana/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- progress/{uid} --------------------------------------------------------
    // Compact per-user progress summary (headline stats + rolling daily map) so the
    // Progress tab and linked family views have a compact summary. Full performance
    // history is separately backed up in the owner-only practiceRecords collection.
    // Read:  the user themself, or a parent with an APPROVED link to this child.
    // Write: only the user themself.
    match /progress/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isApprovedLink(request.auth.uid, uid)
      );
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Cutover is permanent. Old anonymous increments cannot corrupt a repaired summary.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        (!('sessionProjectionVersion' in resource.data) ||
          (request.resource.data.sessionProjectionVersion >= resource.data.sessionProjectionVersion &&
           (request.resource.data.sessionProjectionRevision > resource.data.sessionProjectionRevision ||
            (request.resource.data.sessionProjectionRevision == resource.data.sessionProjectionRevision &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncCheckpoints', 'updatedAt'])))));
      allow delete: if isSignedIn() && request.auth.uid == uid && !('sessionProjectionVersion' in resource.data);
    }
  }
}
